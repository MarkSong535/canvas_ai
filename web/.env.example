# Build-time settings (Vite). Copy to .env.local to override; both have production defaults.
# WebSocket endpoint of ws_server.py
VITE_WS_ENDPOINT=wss://canvas.marksong.tech/
# Cloudflare Turnstile site key (1x00000000000000000000AA is Cloudflare's always-pass test key)
VITE_TURNSTILE_SITEKEY=0x4AAAAAAFTnE5faRQhVop6D
# Dev server only (ignored by `npm run build`): skip the Turnstile challenge, e.g. when testing against a local mock
# VITE_SKIP_TURNSTILE=1
